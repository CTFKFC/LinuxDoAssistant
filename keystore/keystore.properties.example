# 复制为 keystore.properties 并填入你自己的密钥信息。
# 本文件已被 .gitignore 忽略，不会进版本库。
#
# 生成密钥库：
#   keytool -genkeypair -v -keystore keystore/release.jks \
#     -keyalg RSA -keysize 4096 -validity 10000 -alias linuxdo
#
# ⚠️ release.jks 一旦丢失，就再也无法给已发布的应用推送更新（签名对不上，
#    用户必须卸载重装）。务必离线备份。
storeFile=keystore/release.jks
storePassword=你的密钥库密码
keyAlias=linuxdo
keyPassword=你的密钥密码
